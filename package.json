{
  "name": "universal-commerce-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:i18n": "node scripts/check-hardcoded-i18n.cjs",
    "check:lean": "node scripts/check-lean-budgets.cjs",
    "test:icons": "tsx scripts/tests/test_icon_and_products_fixes.ts",
    "test:products": "tsx scripts/tests/test_products_primary_select.ts",
    "test:suppliers": "tsx scripts/tests/test_supplier_connectors.ts",
    "test:sync-epoch": "tsx scripts/tests/test_catalog_epoch_sync.ts",
    "test:intershop": "tsx scripts/tests/test_intershop_affiliate.ts",
    "test:seller-sepay": "tsx scripts/tests/test_seller_direct_sepay.ts",
    "test:seller-portal": "tsx scripts/tests/test_seller_portal_standalone.ts",
    "test": "npm run test:icons && npm run test:products && npm run test:suppliers && npm run test:sync-epoch && npm run test:intershop && npm run test:seller-sepay && npm run test:seller-portal",
    "build": "node scripts/build.cjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=universal-mall-shop --branch=main",
    "deploy:admin": "npm run build && wrangler pages deploy dist --project-name=admin-universal-mall --branch=main",
    "deploy:all": "npm run build && wrangler pages deploy dist --project-name=universal-mall-shop --branch=main && wrangler pages deploy dist --project-name=admin-universal-mall --branch=main"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "fuse.js": "^7.1.0",
    "imagescript": "^3.14.0",
    "lucide-react": "^1.16.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.8.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "dotenv": "^18.0.6",
    "pngjs": "^7.0.0",
    "postcss": "^8.4.47",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wrangler": "^4.141.0"
  }
}
