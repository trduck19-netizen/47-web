# Environment Configuration Template for Universal Mall
# NOTE: Do NOT commit actual secrets or credentials to Git! (Rule 10 Zero Secrets)

# ==========================================
# 1. Server-side Secrets (Cloudflare Pages Environment Variables)
# ==========================================
PASSWORD_PEPPER=CHANGE_ME_AT_LEAST_32_CHARS_SERVER_PEPPER
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_JWT_SECRET
ADMIN_API_KEY=CHANGE_ME_AT_LEAST_32_CHARS_ADMIN_KEY
SYNC_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_SYNC_SECRET
CRON_SECRET=CHANGE_ME_AT_LEAST_32_CHARS_CRON_SECRET
MARKETPLACE_CODE_KEY=CHANGE_ME_MARKETPLACE_KEY
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
ENVIRONMENT=production

# ==========================================
# 2. Client-side Build Variables (Vite Frontend)
# ==========================================
# CẢNH BÁO BẢO MẬT: Mọi biến có tiền tố VITE_* sẽ bị inline trực tiếp thành chuỗi literal trong file JS bundle phát hành.
# VITE_PASSWORD_PEPPER: Chỉ dùng riêng cho build client khi cần kiểm thử offline độc lập.
# TUYỆT ĐỐI KHÔNG dùng chung giá trị với PASSWORD_PEPPER máy chủ. Để trống khi triển khai production để mọi hàm băm chạy 100% trên server.
VITE_PASSWORD_PEPPER=

# Cloudflare Turnstile Site Key (Khóa công khai chống bot)
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
