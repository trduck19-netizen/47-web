# ==============================================================================
# UNIVERSAL MALL - CLOUDFLARE ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================
# HƯỚNG DẪN BẢO MẬT:
# 1. KHÔNG commit file chứa giá trị thật (.env, .dev.vars) lên Git repo (Tuân thủ Rule 10 Zero Secrets).
# 2. Để chạy môi trường cục bộ: Sao chép tệp này thành .dev.vars (cho Wrangler) hoặc .env (cho Vite).
# 3. Để triển khai Production: Khai báo các biến server trên Cloudflare Dashboard:
#    Workers & Pages > universal-mall-shop > Settings > Environment Variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BẢO MẬT & XÁC THỰC CỐT LÕI (CORE AUTH & SECURITY)
# ------------------------------------------------------------------------------
# Chuỗi bí mật ký và xác thực JWT token của người dùng và quản trị viên (Tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_CHARS

# Khóa pepper máy chủ dùng để băm mật khẩu người dùng với PBKDF2/SHA-256 (Tối thiểu 32 ký tự)
PASSWORD_PEPPER=CHANGE_ME_SECURE_SERVER_PEPPER_AT_LEAST_32_CHARS

# Khóa Master Secret của Quản trị viên cấp cao nhất (Dùng xác thực tác vụ admin khẩn cấp)
ADMIN_API_KEY=CHANGE_ME_ADMIN_MASTER_API_KEY_AT_LEAST_32_CHARS

# Khóa bí mật xác thực đồng bộ giữa Web Khách và Cổng Quản trị (Admin Sync API)
ADMIN_SYNC_SECRET=CHANGE_ME_ADMIN_SYNC_SECRET_AT_LEAST_32_CHARS

# Khóa đồng bộ dữ liệu (Sync Secret) cho các tiến trình nền
SYNC_SECRET=CHANGE_ME_SYNC_SECRET_AT_LEAST_32_CHARS

# Khóa bí mật dùng cho Scheduled Cron Workers kích hoạt tác vụ ngầm định kỳ
CRON_SECRET=CHANGE_ME_CRON_TRIGGER_SECRET_AT_LEAST_32_CHARS

# Khóa mã hóa đối xứng AES-GCM 256-bit dùng để mã hóa kho giftcode kỹ thuật số trong D1
MARKETPLACE_CODE_KEY=CHANGE_ME_AES256_KEY_FOR_DIGITAL_CODE_ENCRYPTION

# Môi trường chạy ứng dụng (production / development / test)
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 2. XÁC THỰC CHỐNG BOT (CLOUDFLARE TURNSTILE)
# ------------------------------------------------------------------------------
# Khóa bí mật (Secret Key) từ Cloudflare Dashboard > Turnstile để backend siteverify
TURNSTILE_SECRET_KEY=CHANGE_ME_TURNSTILE_SECRET_KEY
CF_TURNSTILE_SECRET=CHANGE_ME_TURNSTILE_SECRET_KEY

# ------------------------------------------------------------------------------
# 3. CỔNG THANH TOÁN TỰ ĐỘNG (PAYMENT GATEWAYS)
# ------------------------------------------------------------------------------
# API Token từ SePay để đối soát giao dịch chuyển khoản VietQR tự động và xác thực webhook
SEPAY_API_KEY=CHANGE_ME_SEPAY_API_TOKEN

# ------------------------------------------------------------------------------
# 4. HÃNG VẬN CHUYỂN TOÀN QUỐC (SHIPPING CARRIERS)
# ------------------------------------------------------------------------------
# API Token Giao Hàng Tiết Kiệm (GHTK) để tính phí vận chuyển và tạo vận đơn
GHTK_API_TOKEN=CHANGE_ME_GHTK_API_TOKEN

# API Token Giao Hàng Nhanh (GHN Express)
GHN_API_TOKEN=CHANGE_ME_GHN_API_TOKEN
# ID cửa hàng đăng ký trên GHN Express
GHN_SHOP_ID=CHANGE_ME_GHN_SHOP_ID

# API Token Viettel Post để tính cước và tra cứu bưu cục
VIETTEL_POST_TOKEN=CHANGE_ME_VIETTEL_POST_TOKEN

# ------------------------------------------------------------------------------
# 5. THÔNG BÁO & BOT TELEGRAM (TELEGRAM INTEGRATION)
# ------------------------------------------------------------------------------
# Token Bot Telegram do @BotFather cấp
TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN

# Tên người dùng của Telegram Bot (ví dụ: UniversalMallNotifyBot)
TELEGRAM_BOT_USERNAME=CHANGE_ME_TELEGRAM_BOT_USERNAME

# Chat ID nhận cảnh báo đơn hàng, thanh toán và nhật ký bảo mật
TELEGRAM_CHAT_ID=CHANGE_ME_TELEGRAM_ADMIN_CHAT_ID

# Chuỗi bí mật xác thực tính hợp lệ của Webhook gửi từ Telegram Server
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME_TELEGRAM_WEBHOOK_SECRET

# ------------------------------------------------------------------------------
# 6. DỊCH VỤ EMAIL HỆ THỐNG (TRANSACTIONAL EMAILS)
# ------------------------------------------------------------------------------
# Địa chỉ email gửi thông báo hệ thống (ví dụ: no-reply@universal-mall-shop.pages.dev)
EMAIL_FROM=no-reply@universal-mall-shop.pages.dev

# API Key của dịch vụ Resend (Ưu tiên số 1)
RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY

# API Key của dịch vụ SendGrid (Dự phòng số 2)
SENDGRID_API_KEY=CHANGE_ME_SENDGRID_API_KEY

# API Key của dịch vụ Brevo / Sendinblue (Dự phòng số 3)
BREVO_API_KEY=CHANGE_ME_BREVO_API_KEY

# ------------------------------------------------------------------------------
# 7. TRÍ TUỆ NHÂN TẠO & TỐI ƯU HÌNH ẢNH (AI & IMAGE SERVICES)
# ------------------------------------------------------------------------------
# Google Gemini API Key dùng cho tính năng phân tích nội dung và trợ lý AI
GEMINI_API_KEY=CHANGE_ME_GOOGLE_GEMINI_API_KEY
AI_API_KEY=CHANGE_ME_AI_API_KEY

# API Key sinh ảnh bằng trí tuệ nhân tạo
IMAGE_AI_API_KEY=CHANGE_ME_IMAGE_AI_API_KEY

# API Key TinyPNG / Tinify dùng cho tính năng nén ảnh WebP tự động
TINIFY_API_KEY=CHANGE_ME_TINIFY_API_KEY
TINYPNG_API_KEY=CHANGE_ME_TINIFY_API_KEY

# ------------------------------------------------------------------------------
# 8. QUẢN LÝ CACHE & CLOUDFLARE EDGE (CLOUDFLARE API)
# ------------------------------------------------------------------------------
# Cloudflare API Token có quyền Purge Cache của Zone
CLOUDFLARE_API_TOKEN=CHANGE_ME_CLOUDFLARE_API_TOKEN
CF_API_TOKEN=CHANGE_ME_CLOUDFLARE_API_TOKEN

# Zone ID của tên miền trên Cloudflare
CLOUDFLARE_ZONE_ID=CHANGE_ME_CLOUDFLARE_ZONE_ID
CF_ZONE_ID=CHANGE_ME_CLOUDFLARE_ZONE_ID

# ------------------------------------------------------------------------------
# 9. BIẾN BUILD GIAO DIỆN PHÍA CLIENT (VITE FRONTEND BUILD VARIABLES)
# ------------------------------------------------------------------------------
# CẢNH BÁO: Mọi biến có tiền tố VITE_* sẽ bị chèn thẳng vào JS bundle công khai.
# TUYỆT ĐỐI KHÔNG gán mật khẩu, khóa bí mật vào các biến VITE_*.

# URL gốc chính thức của website
VITE_SITE_URL=https://universal-mall-shop.pages.dev

# Site Key công khai hiển thị widget Cloudflare Turnstile ở khung Đăng ký / Đăng nhập
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# BẢO MẬT: Bắt buộc để trống trên môi trường phát hành Production!
VITE_PASSWORD_PEPPER=
